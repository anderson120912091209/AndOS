# LINE Developers Console → your channel. Channel ID + secret: Basic settings. `pnpm dev` issues the access token itself.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

ANTHROPIC_API_KEY=

# A fixed public address (ngrok free static domain), needed for 「連結 Google 帳號」.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by `pnpm dev`; signs OAuth state.
PIKO_SECRET=

BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

PORT=8790
